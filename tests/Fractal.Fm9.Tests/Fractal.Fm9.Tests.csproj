<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fractal.Fm9\Fractal.Fm9.csproj" />
  </ItemGroup>

  <!-- Only the presets these tests need; the public repository ships exactly these. -->
  <ItemGroup>
    <None Include="..\..\Presets\metallica-eight-scenes.syx" Link="Presets\metallica-eight-scenes.syx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Presets\fm9-uploaded-shunts.syx" Link="Presets\fm9-uploaded-shunts.syx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Presets\fm9-uploaded-usb-input.syx" Link="Presets\fm9-uploaded-usb-input.syx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Presets\gen3-*.syx" LinkBase="Presets" CopyToOutputDirectory="PreserveNewest" />
    <!-- One-second 440 Hz tones made with ffmpeg's sine generator, one per format. -->
    <None Include="Audio\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- One cap for every suite: -m limits projects, not the threads inside one. -->
    <Content Include="..\xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
