<Project Sdk="Microsoft.NET.Sdk">

  <!-- fractone-probe: the probe kit's command line, the same engine the GUI will use. Windows only in v1 (USB MIDI through
       WinMM); the engine and scripts stay portable. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>fractone-probe</AssemblyName>
    <RootNamespace>FracTone.Probe.Cli</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FracTone.Probe\FracTone.Probe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FracTone.Probe.Tests" />
  </ItemGroup>

</Project>
